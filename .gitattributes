# Normalise text, but never let autocrlf touch binary assets.
# Without this, Unity's binary files get treated as text and show up
# permanently modified — which also breaks merges from the art workers.
* text=auto

# Unity text assets
*.cs        text diff=csharp
*.shader    text
*.hlsl      text
*.cginc     text
*.json      text
*.md        text
*.asmdef    text
*.meta      text eol=lf
*.unity     text eol=lf
*.prefab    text eol=lf
*.asset     text eol=lf
*.mat       text eol=lf
*.controller text eol=lf
*.anim      text eol=lf
*.physicMaterial text eol=lf
*.shadergraph text eol=lf
*.vfx       text eol=lf

# Binary — never convert, never diff
*.png       binary
*.jpg       binary
*.jpeg      binary
*.tga       binary
*.psd       binary
*.exr       binary
*.hdr       binary
*.fbx       binary
*.blend     binary
*.blend1    binary
*.obj       binary
*.glb       binary
*.gltf      binary
*.wav       binary
*.mp3       binary
*.ogg       binary
*.joblib    binary
*.bin       binary
*.dll       binary
*.so        binary
*.pdf       binary
*.ttf       binary
*.otf       binary
*.cubemap   binary
*.mixer     binary
