%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!21 &2100000
Material:
  serializedVersion: 8
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_Name: M_Water_Lake
  m_Shader: {fileID: 4800000, guid: 0da61062b47b9b2e285bc086a94a128c, type: 3}
  m_Parent: {fileID: 0}
  m_ModifiedSerializedProperties: 0
  m_ValidKeywords: []
  m_InvalidKeywords: []
  m_LightmapFlags: 4
  m_EnableInstancingVariants: 0
  m_DoubleSidedGI: 0
  m_CustomRenderQueue: -1
  stringTagMap: {}
  disabledShaderPasses: []
  m_LockedProperties:
  m_SavedProperties:
    serializedVersion: 3
    # No normal map is assigned, so the shader falls back to a flat "bump" and the
    # surface detail comes entirely from the procedural layers below. That is why
    # their scales matter so much here and why they were reading as a pattern
    # rather than as water.
    m_TexEnvs: []
    m_Ints: []
    m_Floats:
    - _DepthRange: 3.5
    - _Transparency: 0.86
    - _NormalScaleA: 0.14
    - _NormalScaleB: 0.37
    - _NormalStrength: 0.85
    - _WaveAmplitude: 0.055
    - _WaveLength: 4.2
    - _WaveSpeed: 0.65
    - _WaveSteepness: 0.35
    - _RefractionStrength: 0.035
    # Foam sized between the two failures. The shader default of 2.2 is a cell under
    # half a metre, which repeats ~70 times across a 32 m lake and reads as a white
    # lattice; dropping it to 0.42 overshot the other way into 2.4 m cotton-wool
    # blobs floating in open water. 1.1 puts the cell near 0.9 m. Crest foam is
    # nearly off because foam belongs at the shore, and the crest term was what put
    # it out in the middle.
    - _FoamDepth: 0.35
    - _FoamSharpness: 2.2
    - _FoamScale: 1.1
    - _FoamSpeed: 0.22
    - _FoamCrest: 0.1
    - _ShoreBandSpeed: 0.9
    # Same correction. 1.6 gives a 0.6 m cell that tiles ~50 times across the lake
    # and weaves into a grid; 0.3 gave 3.3 m and turned the pattern into large soft
    # islands. 0.85 lands near 1.2 m, and the strength is down as well because these
    # only belong in water shallow enough to see the bed through.
    - _CausticStrength: 0.45
    - _CausticScale: 0.85
    - _CausticSpeed: 0.28
    - _CausticDepthRange: 2.2
    - _SpecularSharpness: 420
    - _SpecularStrength: 2
    # 22 is a sub-texel frequency at this camera distance and produces crawling
    # aliasing rather than glitter.
    - _SparkleScale: 7
    - _SparkleStrength: 0.55
    - _SparkleThreshold: 0.975
    - _FresnelPower: 4.2
    - _ReflectionStrength: 1.1
    m_Colors:
    - _ShallowColor: {r: 0.32, g: 0.78, b: 0.76, a: 1}
    - _DeepColor: {r: 0.03, g: 0.18, b: 0.32, a: 1}
    - _HorizonColor: {r: 0.55, g: 0.86, b: 0.92, a: 1}
    - _NormalSpeedA: {r: 0.021, g: 0.013, b: 0, a: 0}
    - _NormalSpeedB: {r: -0.015, g: 0.024, b: 0, a: 0}
    - _WaveDirection: {r: 1, g: 0.35, b: 0, a: 0}
    - _RefractionTint: {r: 0.62, g: 0.92, b: 0.88, a: 1}
    - _FoamColor: {r: 1, g: 1, b: 1, a: 1}
    - _CausticColor: {r: 0.85, g: 1, b: 0.92, a: 1}
    - _SpecularColor: {r: 1, g: 0.97, b: 0.88, a: 1}
  m_BuildTextureStacks: []
