%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!21 &2100000
Material:
  serializedVersion: 8
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_Name: M_Ground_TerrainBlend
  m_Shader: {fileID: 4800000, guid: 07367a3021ca7bfa4f5cda950ad63e3b, type: 3}
  m_Parent: {fileID: 0}
  m_ModifiedSerializedProperties: 0
  m_ValidKeywords: []
  m_InvalidKeywords: []
  m_LightmapFlags: 4
  m_EnableInstancingVariants: 1
  m_DoubleSidedGI: 0
  m_CustomRenderQueue: -1
  stringTagMap: {}
  disabledShaderPasses: []
  m_LockedProperties:
  m_SavedProperties:
    serializedVersion: 3
    # The four layer maps are left unassigned on purpose and fall back to the shader's
    # white default, so each layer is driven by its tint alone. The environment kit only
    # ships a packed atlas, and these layers tile planar over world XZ: pointing them at
    # an atlas would smear the grass, dirt and rock cells into each other across every
    # square metre of the map. Flat tinted layers read correctly for the stylised target
    # in the meantime, and the weights, slope response and blending below are all live.
    m_TexEnvs: []
    m_Ints: []
    m_Floats:
    - _Layer0Scale: 0.35
    - _Layer1Scale: 0.5
    - _Layer2Scale: 0.6
    - _Layer3Scale: 0.28
    - _Layer0NormalScale: 1
    - _Layer1NormalScale: 1
    - _Layer2NormalScale: 1
    - _Layer3NormalScale: 1
    - _TriplanarSharpness: 5
    - _UseControlMap: 0
    - _HeightContrast: 0.18
    # Rock takes over between these two angles. The slice's ground runs to 85 deg in
    # places, and this is what puts stone on those faces without anyone painting them.
    - _SlopeStart: 30
    - _SlopeEnd: 52
    - _MacroVariation: 0.4
    - _MacroScale: 26
    - _Wetness: 0
    # The lake surface, so the shore damp band lands at the actual waterline.
    - _WaterLevel: -2.2
    - _ShoreWetHeight: 0.6
    - _PuddleAmount: 0.35
    - _PuddleScale: 3.5
    - _ShadeSteps: 3
    - _ShadeSoftness: 0.02
    - _ShadeWrap: 0.2
    - _ShadowStrength: 0.85
    - _SpecularStrength: 0.03
    - _SpecularSharpness: 32
    m_Colors:
    - _Layer0Color: {r: 0.45, g: 0.62, b: 0.28, a: 1}
    - _Layer1Color: {r: 0.42, g: 0.31, b: 0.21, a: 1}
    - _Layer2Color: {r: 0.82, g: 0.74, b: 0.55, a: 1}
    - _Layer3Color: {r: 0.46, g: 0.45, b: 0.48, a: 1}
    - _ShadeColor: {r: 0.42, g: 0.5, b: 0.68, a: 1}
  m_BuildTextureStacks: []
