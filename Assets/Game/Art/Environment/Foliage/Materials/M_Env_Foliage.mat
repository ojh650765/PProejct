    serializedVersion: 3
    m_TexEnvs:
    - _BaseMap:
        m_Texture: {fileID: 2800000, guid: 371a889a3e7dcd74a8558be6eb909a03, type: 3}
        m_Scale: {x: 1, y: 1}
        m_Offset: {x: 0, y: 0}
    - _BumpMap:
        m_Texture: {fileID: 2800000, guid: ce136a980e6f2e945a105642d0b9afa7, type: 3}
        m_Scale: {x: 1, y: 1}
        m_Offset: {x: 0, y: 0}
    m_Ints: []
    m_Floats:
    - _BumpScale: 0.7
    # The atlas is an RGB PNG with no alpha channel, so sampled alpha is always 1
    # and the clip is a no-op. Cutoff is left at its default rather than raised,
    # because raising it on alpha-free art would clip the entire canopy away the
    # moment someone exports an atlas that does carry alpha.
    - _Cutoff: 0.45
    # Off deliberately. Alpha-to-coverage costs an MSAA resolve and dithers edges
    # for a coverage value that is constant 1 on this art; it earns its keep only
    # on real cutout foliage.
    - _AlphaToMask: 0
    - _GradientPower: 1
    - _VariationStrength: 0.35
    - _ShadeSteps: 3
    - _ShadeSoftness: 0.02
    - _ShadeWrap: 0.45
    - _ShadowStrength: 0.65
    - _OcclusionStrength: 0.8
    - _TranslucencyStrength: 1.6
    - _TranslucencyPower: 5
    - _SpecularStrength: 0.08
    - _SpecularSharpness: 36
    - _RimStrength: 0.5
    - _RimPower: 3
    - _SwayAmplitude: 0.16
    - _SwaySpeed: 0.9
    - _FlutterAmplitude: 0.045
    - _FlutterSpeed: 6.5
    - _GustStrength: 0.9
    - _WindDistanceFade: 45
    - _NormalSpherify: 0.45
    m_Colors:
    - _BaseColor: {r: 1, g: 1, b: 1, a: 1}
