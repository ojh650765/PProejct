{
  "name": "pokelab-online",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:apply": "wrangler d1 execute pokelab --remote --file=./schema.sql",
    "db:apply:local": "wrangler d1 execute pokelab --local --file=./schema.sql",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260916.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.124.0"
  }
}
